# macOS
.DS_Store
**/.DS_Store

# 대용량 원본 이미지 (압축본 images/hero-1.jpg 등은 커밋됨)
images/*-utc.jpg
images/*-utc.JPG

# 강사 프로필 원본 사진 (압축본 images/instructors/*.jpg는 커밋됨)
images/강사 프로필/

# Claude Code 에디터 설정
.claude/*
!.claude/settings.json
!.claude/skills/

# Supabase Edge Functions 로컬 환경 변수
supabase/.env
supabase/functions/.env
migration_data_final.json

# 시즌 일러스트 원본 (누끼 딴 chuseok-*.png 만 커밋한다)
images/season/Gemini_Generated_Image_*.png

# 테마 작업용 미리보기 쪽 (모티프를 한눈에 보려고 쓴다. 사이트에는 안 쓴다)
themes/*/_preview.html
